# =====================================
# Backend Dockerfile - Development
# =====================================

FROM node:20-bullseye

# OpenSSL necesario para Prisma
RUN apt-get update -y \
  && apt-get install -y openssl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Dependencias (incluye @swc/core para compilación rápida)
COPY package*.json ./
RUN npm install

# 2. Copiar esquema Prisma y generar el client durante el BUILD
#    (no en cada arranque del CMD → ahorra ~5-15 seg por reinicio)
COPY prisma ./prisma
RUN npx prisma generate

# 3. Copiar el resto del código (en runtime se sobreescribe con volumes)
COPY . .

# 4. Variables por defecto para dev
ENV NODE_ENV=development

# 5. Puerto API y Prisma Studio
EXPOSE 3000
EXPOSE 5555

# 6. Arranque con hot reload — SWC ya está configurado en nest-cli.json
CMD ["npm", "run", "start:dev"]
